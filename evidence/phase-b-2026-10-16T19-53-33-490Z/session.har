":"[{\"id\":\"5a16e0c5-f5b4-4998-ac13-0c2ea565ec16\",\"tenant_id\":\"42d36cee-4cd6-43d1-af5d-334e5a07e37c\",\"slug\":\"sports\",\"name\":\"Sports & Athletics\",\"headline\":\"Fueling Teams, Athletes & Fitness Communities\",\"description\":\"Cold-crafted antioxidant recovery beverages for clubs, tournaments, gyms, and sports events.\",\"buyer_summary\":\"Football clubs, fitness centres, tournament organizers, and athlete delegations.\",\"cta_label\":\"Get Sports Bulk Price\",\"landing_path\":\"/sports\",\"active\":true,\"sort_order\":1,\"created_by\":null,\"created_at\":\"2026-10-05T21:31:15.667651+00:00\",\"updated_at\":\"2026-10-05T21:31:15.667651+00:00\"}, \n {\"id\":\"429b17ef-20c7-483b-b6d3-0836fb482a9f\",\"tenant_id\":\"42d36cee-4cd6-43d1-af5d-334e5a07e37c\",\"slug\":\"parties-events\",\"name\":\"Parties & Events\",\"headline\":\"Chilled Artisanal Drinks for Unforgettable Gatherings\",\"description\":\"Premium ice-cold Zobo Sweet and superfruit mixes for weddings, birthdays, corporate celebrations, and festive parties.\",\"buyer_summary\":\"Event planners, wedding couples, family celebrants, and event coordinators.\",\"cta_label\":\"Get My Event Quote\",\"landing_path\":\"/events\",\"active\":true,\"sort_order\":2,\"created_by\":null,\"created_at\":\"2026-10-05T21:31:18.328125+00:00\",\"updated_at\":\"2026-10-05T21:31:18.328125+00:00\"}, \n {\"id\":\"af2fc88b-5faa-4cc9-8692-1bcdbb01f019\",\"tenant_id\":\"42d36cee-4cd6-43d1-af5d-334e5a07e37c\",\"slug\":\"hotels-hospitality\",\"name\":\"Hotels & Hospitality\",\"headline\":\"Turnkey Beverage Supply for Hotels, Lounges & Restaurants\",\"description\":\"Reliable cold-chain replenishment, bar stock, and breakfast buffet juice carafes with official trade invoicing.\",\"buyer_summary\":\"Hotel F&B managers, lounge operators, resorts, and café proprietors.\",\"cta_label\":\"Request Hotel Supply\",\"landing_path\":\"/hotels\",\"active\":true,\"sort_order\":3,\"created_by\":null,\"created_at\":\"2026-10-05T21:31:21.134632+00:00\",\"updated_at\":\"2026-10-05T21:31:21.134632+00:00\"}, \n {\"id\":\"151a6847-9654-4f90-94f2-49a674b1b35b\",\"tenant_id\":\"42d36cee-4cd6-43d1-af5d-334e5a07e37c\",\"slug\":\"schools\",\"name\":\"Schools & Campuses\",\"headline\":\"Wholesome Fruit Hydration for Students & School Events\",\"description\":\"Zero artificial preservatives, pure hibiscus botanical vitamins, and cold-packed drinks approved for school sports, tuck shops, and graduation ceremonies.\",\"buyer_summary\":\"School administrators, tuck shop vendors, PTAs, and parent coordinators.\",\"cta_label\":\"Request School Beverage Program\",\"landing_path\":\"/schools\",\"active\":true,\"sort_order\":4,\"created_by\":null,\"created_at\":\"2026-10-05T21:31:23.792498+00:00\",\"updated_at\":\"2026-10-05T21:31:23.792498+00:00\"}, \n {\"id\":\"e224e7f3-310c-4f43-8913-a3b0b8df9eec\",\"tenant_id\":\"42d36cee-4cd6-43d1-af5d-334e5a07e37c\",\"slug\":\"individuals\",\"name\":\"Individuals & Direct Orders\",\"headline\":\"Fresh Cold Bottles Delivered to Your Doorstep\",\"description\":\"Order your personal daily antioxidant boost directly: fresh Zobo Sweet and Luxury Juice Mix bottled daily in Sapele.\",\"buyer_summary\":\"Individual consumers, families, wellness enthusiasts, and home stockists.\",\"cta_label\":\"Order on WhatsApp\",\"landing_path\":\"/individuals\",\"active\":true,\"sort_order\":5,\"created_by\":null,\"created_at\":\"2026-10-05T21:31:26.340497+00:00\",\"updated_at\":\"2026-10-05T21:31:26.340497+00:00\"}]"},"headersSize":0,"bodySize":2182,"redirectURL":"","_transferSize":2182},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":242.317,"receive":11.098},"_frameref":"frame@c6b3180024687624f679daa2979450f0","_monotonicTime":12650.963,"_resourceType":"fetch","serverIPAddress":"104.18.38.10","_serverPort":443,"_securityDetails":{"protocol":"QUIC","subjectName":"supabase.co","issuer":"WE1","validFrom":1787742948,"validTo":1795522545}},{"pageref":"page@ade78e33f66f78cd029df07251dcf82