ze":50986,"redirectURL":"","_transferSize":51296},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":253.152,"receive":9.273},"_frameref":"frame@c6b3180024687624f679daa2979450f0","_monotonicTime":2736.941,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":3000,"_securityDetails":{}},{"pageref":"page@ade78e33f66f78cd029df07251dcf821","startedDateTime":"2026-10-16T19:53:34.969Z","time":15.305,"request":{"method":"GET","url":"http://localhost:3000/src/services/productsService.ts","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:3000"},{"name":"Origin","value":"http://localhost:3000"},{"name":"Referer","value":"http://localhost:3000/src/components/navigation/Footer.tsx"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":591,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Access-Control-Allow-Origin","value":"http://localhost:3000"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"75516"},{"name":"Content-Type","value":"text/javascript"},{"name":"Date","value":"Fri, 16 Oct 2026 19:53:35 GMT"},{"name":"Etag","value":"W/\"5739-URvukGwsITm+QMByJVb0N8tIdNg\""},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Vary","value":"Origin"}],"content":{"size":75516,"mimeType":"text/javascript","compression":0,"text":"import { supabase, TENANT_ID, notifySyncEvent } from \"/src/lib/supabase.ts\";\nimport { BUCKET_NAME, isValidUuid, ACCEPTED_IMAGE_MIME_TYPES } from \"/src/services/mediaService.ts\";\nconst getErrMsg = (err, fallback) => {\n\tif (err && typeof err === \"object\" && \"message\" in err) {\n\t\treturn String(err.message);\n\t}\n\treturn err ? String(err) : fallback;\n};\nconst PRODUCT_SELECT_QUERY = `\n  *,\n  category:product_categories(*),\n  variants:product_variants(*, prices:product_prices(*)),\n  media:product_media(*, media_assets(*)),\n  claims:product_claims(*)\n`;\n/**\n* Shared Publication Validator satisfying HOEOS G1/G2 Publication Gate:\n* Enforces all 8 prerequisite rules against persisted Supabase records:\n* 1. Target product exists and tenant matches expected tenant (TENANT_ID).\n* 2. product_media association exists for exact product with is_primary = true.\n* 3. Associated media_assets record exists and has same tenant as product (TENANT_ID).\n* 4. Media asset bucket is exactly 'cp-public'.\n* 5. Media asset status is exactly 'active'.\n* 6. Media asset media_type is exactly 'image'.\n* 7. MIME type is an accepted image MIME type (image/jpeg, image/png, image/webp, image/gif).\n* 8. Storage path matches expected prefix: products/{productId}/...\n*/\nexport async function validateProductPublication(productId) {\n\tif (!productId || typeof productId !== \"string\" || !isValidUuid(productId.trim())) {\n\t\treturn {\n\t\t\tisValid: false,\n\t\t\terror: `Invalid product ID \"${productId}\": must be a valid UUID`\n\t\t};\n\t}\n\tconst cleanProductId = productId.trim();\n\ttry {\n\t\t// 1. Establish product existence and tenant match\n\t\tconst { data: product, error: prodErr } = await supabase.from(\"products\").select(\"id, tenant_id, status\").eq(\"id\", cleanProductId).single();\n\t\tif (prodErr || !product) {\n\t\t\tconst isNotFound = prodErr && typeof prodErr === \"object\" && (\"code\" in prodErr && prodErr.code === \"PGRST116\" || \"details\" in prodErr && String(prodErr.details).includes(\"0 rows\"));\n\t\t\treturn {\n\t\t\t\tisValid: false,\n\t\t\t\terror: isNotFound ? `Product ${cleanProductId} not found in database` : `Database verification error checking product existence: ${prodErr ? getErrMsg(prodErr, \"Query failed\") : \"Product not found\"}`\n\t\t\t};\n\t\t}\n\t\tif (product.tenant_id !== TENANT_ID) {\n\t\t\treturn {\n\t\t\t\tisValid: false,\n\t\t\t\terror: `Product tenant mismatch: product belongs to tenant \"${product.tenant_id}\", expected current tenant \"${TENANT_ID}\"`\n\t\t\t};\n\t\t}\n\t\t// 2. Query product_media for primary media association\n\t\tconst { data: mediaLinks, error: mediaErr } = await supabase.from(\"product_media\").select(\"product_id, media_id, is_primary, media_assets(*)\").eq(\"product_id\", cleanProductId).eq(\"is_primary\", true);\n\t\tif (mediaErr) {\n\t\t\treturn {\n\t\t\t\tisValid: false,\n\t\t\t\terror: `Database verification error checking primary media association: ${getErrMsg(mediaErr, \"Query failed\")}`\n\t\t\t};\n\t\t}\n\t\tif (!mediaLinks || mediaLinks.length === 0) {\n\t\t\treturn {\n\t\t\t\tisValid: false,\n\t\t\t\terror: `Publication prerequisite failed: Product ${cleanProductId} has no primary media attached in product_media (is_primary = true)`\n\t\t\t};\n\t\t}\n\t\t// 3 - 8. Validate primary media candidates\n\t\tlet candidateFailureReason = \"\";\n\t\tfor (const rawLink of mediaLinks) {\n\t\t\tconst link = rawLink;\n\t\t\tif (link.product_id !== cleanProductId) {\n\t\t\t\tcandidateFailureReason = `Media link product ID mismatch: expected ${cleanProductId}, found ${link.product_id}`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tif (!link.is_primary) {\n\t\t\t\tcandidateFailureReason = `Media link is not marked as primary (is_primary = false)`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tlet asset = Array.isArray(link.media_assets) ? link.media_assets[0] || null : link.media_assets || null;\n\t\t\t// Fallback: If media_assets was not embedded via relation query, fetch directly\n\t\t\tif (!asset && link.media_id) {\n\t\t\t\tconst { data: directAsset, error: assetErr } = await supabase.from(\"media_assets\").select(\"*\").eq(\"id\", link.media_id).single();\n\t\t\t\tif (assetErr) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tisValid: false,\n\t\t\t\t\t\terror: `Database verification error fetching media asset ${link.media_id}: ${getErrMsg(assetErr, \"Query failed\")}`\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t\tasset = directAsset;\n\t\t\t}\n\t\t\tif (!asset) {\n\t\t\t\tcandidateFailureReason = `Associated media asset record \"${link.media_id}\" does not exist in media_assets`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 3. Asset tenant must match expected tenant & product tenant\n\t\t\tif (asset.tenant_id !== TENANT_ID || asset.tenant_id !== product.tenant_id) {\n\t\t\t\tcandidateFailureReason = `Media asset tenant mismatch: asset tenant \"${asset.tenant_id}\" does not match tenant \"${TENANT_ID}\"`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 4. Bucket must be exactly cp-public\n\t\t\tif (asset.bucket !== BUCKET_NAME) {\n\t\t\t\tcandidateFailureReason = `Media asset bucket mismatch: asset bucket is \"${asset.bucket}\", expected \"${BUCKET_NAME}\"`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 5. Persisted status must be exactly active\n\t\t\tif (asset.status !== \"active\") {\n\t\t\t\tcandidateFailureReason = `Media asset status is \"${asset.status}\"; publication requires an \"active\" primary media asset`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 6. Persisted media_type must be image\n\t\t\tif (asset.media_type !== \"image\") {\n\t\t\t\tcandidateFailureReason = `Primary media asset must have media_type \"image\", but found \"${asset.media_type}\"`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 7. MIME type must be an accepted image MIME type (JPEG, PNG, WebP, GIF)\n\t\t\tconst mime = (asset.mime_type || \"\").toLowerCase().trim();\n\t\t\tif (!mime || !ACCEPTED_IMAGE_MIME_TYPES.has(mime)) {\n\t\t\t\tcandidateFailureReason = `Invalid primary image MIME type \"${asset.mime_type}\". Accepted image MIME types: ${Array.from(ACCEPTED_IMAGE_MIME_TYPES).join(\", \")}`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// 8. Storage path must belong to expected product path: products/{productId}/...\n\t\t\tconst expectedPrefix = `products/${cleanProductId}/`;\n\t\t\tif (!asset.path || !asset.path.startsWith(expectedPrefix) || asset.path.length <= expectedPrefix.length) {\n\t\t\t\tcandidateFailureReason = `Media asset storage path \"${asset.path}\" does not belong to expected product storage path \"${expectedPrefix}*\"`;\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\t// All 8 checks passed!\n\t\t\treturn {\n\t\t\t\tisValid: true,\n\t\t\t\terror: null\n\t\t\t};\n\t\t}\n\t\treturn {\n\t\t\tisValid: false,\n\t\t\terror: `Publication prerequisite failed: ${candidateFailureReason || \"No qualifying primary image found meeting publication requirements\"}`\n\t\t};\n\t} catch (err) {\n\t\treturn {\n\t\t\tisValid: false,\n\t\t\terror: `Unexpected error during publication validation: ${err instanceof Error ? err.message : String(err)}`\n\t\t};\n\t}\n}\nexport const productsService = {\n\tvalidateProductPublication,\n\t/**\n\t* Helper to ensure an authoritative default price list exists for the tenant\n\t*/\n\tasync ensureDefaultPriceList() {\n\t\tconst { data: existing, error: findErr } = await supabase.from(\"price_lists\").select(\"id\").eq(\"tenant_id\", TENANT_ID).eq(\"price_type\", \"retail\").limit(1);\n\t\tif (!findErr && existing && existing.length > 0) {\n\t\t\treturn existing[0].id;\n\t\t}\n\t\tconst { data: created, error: createErr } = await supabase.from(\"price_lists\").insert({\n\t\t\ttenant_id: TENANT_ID,\n\t\t\tname: \"Default Retail\",\n\t\t\tcurrency: \"NGN\",\n\t\t\tprice_type: \"retail\",\n\t\t\tstatus: \"active\"\n\t\t}).select(\"id\").single();\n\t\tif (createErr || !created) {\n\t\t\tthrow new Error(`Failed to initialize price list: ${createErr?.message || \"Unknown error\"}`);\n\t\t}\n\t\treturn created.id;\n\t},\n\t/**\n\t* Public Product Catalog query\n\t* Only returns published products with verified claims and active media\n\t*/\n\tasync getPublishedProducts() {\n\t\ttry {\n\t\t\tconst { data, error } = await supabase.from(\"products\").select(PRODUCT_SELECT_QUERY).eq(\"tenant_id\", TENANT_ID).eq(\"status\", \"published\").order(\"created_at\", { ascending: false });\n\t\t\tif (error) {\n\t\t\t\tconsole.error(\"Error fetching published products:\", error);\n\t\t\t\treturn {\n\t\t\t\t\tdata: [],\n\t\t\t\t\terror: getErrMsg(error, \"Failed to fetch products\")\n\t\t\t\t};\n\t\t\t}\n\t\t\t// Filter claims to verified only for public storefront\n\t\t\tconst sanitized = (data || []).map((p) => ({\n\t\t\t\t...p,\n\t\t\t\tclaims: (p.claims || []).filter((c) => c.verification_status === \"verified\")\n\t\t\t}));\n\t\t\treturn {\n\t\t\t\tdata: sanitized,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\tconsole.error(\"Exception fetching published products:\", err);\n\t\t\treturn {\n\t\t\t\tdata: [],\n\t\t\t\terror: err instanceof Error ? err.message : \"Unknown product error\"\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t* Admin Product Catalog query\n\t* Returns all products (draft, published, archived) for CP Fruit Splash tenant\n\t*/\n\tasync getAllProducts() {\n\t\ttry {\n\t\t\tconst { data, error } = await supabase.from(\"products\").select(PRODUCT_SELECT_QUERY).eq(\"tenant_id\", TENANT_ID).order(\"created_at\", { ascending: false });\n\t\t\tif (error) {\n\t\t\t\tconsole.error(\"Error fetching admin products:\", error);\n\t\t\t\treturn {\n\t\t\t\t\tdata: [],\n\t\t\t\t\terror: getErrMsg(error, \"Failed to fetch products\")\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tdata: data || [],\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\tconsole.error(\"Exception fetching admin products:\", err);\n\t\t\treturn {\n\t\t\t\tdata: [],\n\t\t\t\terror: err instanceof Error ? err.message : \"Unknown admin product error\"\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t* Resolve single product by slug (Authoritative flow: /products/:slug -> Supabase -> product record)\n\t*/\n\tasync getProductBySlug(slug, publicOnly = true) {\n\t\ttry {\n\t\t\tlet query = supabase.from(\"products\").select(PRODUCT_SELECT_QUERY).eq(\"tenant_id\", TENANT_ID).eq(\"slug\", slug);\n\t\t\tif (publicOnly) {\n\t\t\t\tquery = query.eq(\"status\", \"published\");\n\t\t\t}\n\t\t\tconst { data, error } = await query.single();\n\t\t\tif (error || !data) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: error ? getErrMsg(error, \"Product not found\") : \"Product not found\"\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst prod = data;\n\t\t\tif (publicOnly && prod.claims) {\n\t\t\t\tprod.claims = prod.claims.filter((c) => c.verification_status === \"verified\");\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tdata: prod,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\treturn {\n\t\t\t\tdata: null,\n\t\t\t\terror: err instanceof Error ? err.message : \"Unknown slug query error\"\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t* Resolve single product by ID\n\t*/\n\tasync getProductById(id) {\n\t\ttry {\n\t\t\tconst { data, error } = await supabase.from(\"products\").select(PRODUCT_SELECT_QUERY).eq(\"tenant_id\", TENANT_ID).eq(\"id\", id).single();\n\t\t\tif (error || !data) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: error ? getErrMsg(error, \"Product not found\") : \"Product not found\"\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tdata,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\treturn {\n\t\t\t\tdata: null,\n\t\t\t\terror: err instanceof Error ? err.message : \"Error resolving product by id\"\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t* Create Product in Supabase adhering to the authoritative live schema:\n\t* 1. Insert into products (identity & core metadata)\n\t* 2. Insert into product_variants (physical unit: volume, weight)\n\t* 3. Insert into product_prices (price record linked to price_lists and product_variants)\n\t*/\n\tasync createProduct(productData) {\n\t\ttry {\n\t\t\tif (!productData