ression":0,"text":"import { supabase, TENANT_ID, notifySyncEvent } from \"/src/lib/supabase.ts\";\nfunction isValidUuid(id) {\n\tif (!id || typeof id !== \"string\") return false;\n\treturn /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);\n}\nconst getErrMsg = (err, fallback) => {\n\tif (err && typeof err === \"object\" && \"message\" in err) {\n\t\treturn String(err.message);\n\t}\n\treturn err ? String(err) : fallback;\n};\nexport const placementService = {\n\t/**\n\t* Fetch active media placements for a given scope type\n\t* Reads from Supabase media_placements table as single source of truth.\n\t* If migration is pending or table is inaccessible, returns empty array with diagnostic logging.\n\t* Never fabricates unpersisted in-memory placements.\n\t*/\n\tasync getPlacements(scopeType, scopeId, activeOnly = true) {\n\t\ttry {\n\t\t\tlet query = supabase.from(\"media_placements\").select(\"*, media_assets(*)\").eq(\"tenant_id\", TENANT_ID).eq(\"scope_type\", scopeType);\n\t\t\tif (scopeId) {\n\t\t\t\tquery = query.eq(\"scope_id\", scopeId);\n\t\t\t}\n\t\t\tif (activeOnly) {\n\t\t\t\tquery = query.eq(\"active\", true);\n\t\t\t}\n\t\t\tconst { data, error } = await query.order(\"sort_order\", { ascending: true });\n\t\t\tif (error) {\n\t\t\t\tconsole.warn(\"[HOEOS PLACEMENT] Database query error (migration may be pending):\", error.message);\n\t\t\t\treturn [];\n\t\t\t}\n\t\t\tconst list = data || [];\n\t\t\t// Filter to ensure referenced asset is active and in approved bucket\n\t\t\tif (activeOnly) {\n\t\t\t\treturn list.filter((p) => {\n\t\t\t\t\tconst asset = p.media_assets || p.asset;\n\t\t\t\t\treturn !asset || asset.status === \"active\" && asset.bucket === \"cp-public\";\n\t\t\t\t});\n\t\t\t}\n\t\t\treturn list;\n\t\t} catch (err) {\n\t\t\tconsole.warn(\"[HOEOS PLACEMENT] Exception reading placements:\", err);\n\t\t\treturn [];\n\t\t}\n\t},\n\t/**\n\t* Fetch all placements for CMS admin management\n\t*/\n\tasync getAllPlacements() {\n\t\ttry {\n\t\t\tconst { data, error } = await supabase.from(\"media_placements\").select(\"*, media_assets(*)\").eq(\"tenant_id\", TENANT_ID).order(\"scope_type\", { ascending: true }).order(\"sort_order\", { ascending: true });\n\t\t\tif (error) {\n\t\t\t\tconsole.warn(\"[HOEOS PLACEMENT] Database query error in getAllPlacements:\", error.message);\n\t\t\t\treturn [];\n\t\t\t}\n\t\t\treturn data || [];\n\t\t} catch (err) {\n\t\t\tconsole.warn(\"[HOEOS PLACEMENT] Exception in getAllPlacements:\", err);\n\t\t\treturn [];\n\t\t}\n\t},\n\t/**\n\t* Create a new persistent media placement.\n\t* Enforces:\n\t* 1. Media asset tenant consistency (rejects cross-tenant media).\n\t* 2. Campaign / Sales journey tenant consistency when referenced.\n\t* 3. Concrete Supabase persistence (fails closed if migration missing or write fails).\n\t* 4. Reload-based publication verification (must re-query from database before reporting success).\n\t*/\n\tasync createPlacement(placement) {\n\t\ttry {\n\t\t\t// 1. UUID syntax validation\n\t\t\tif (!isValidUuid(placement.media_id)) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: `Invalid media_id: must be a valid UUID (${placement.media_id})`\n\t\t\t\t};\n\t\t\t}\n\t\t\t// 2. Cross-tenant consistency check for media asset\n\t\t\tconst { data: asset, error: assetErr } = await supabase.from(\"media_assets\").select(\"id, tenant_id, status, bucket\").eq(\"id\", placement.media_id).single();\n\t\t\tif (assetErr || !asset) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: `Referenced media asset not found: ${placement.media_id}`\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (asset.tenant_id !== TENANT_ID) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: `Cross-tenant assignment denied: media asset ${placement.media_id} belongs to tenant ${asset.tenant_id}, not current tenant ${TENANT_ID}`\n\t\t\t\t};\n\t\t\t}\n\t\t\t// 3. Cross-tenant consistency check for campaign scope\n\t\t\tif (placement.scope_type === \"campaign\" && placement.scope_id) {\n\t\t\t\tif (isValidUuid(placement.scope_id)) {\n\t\t\t\t\tconst { data: campaign, error: campErr } = await supabase.from(\"campaigns\").select(\"id, tenant_id\").eq(\"id\", placement.scope_id).single();\n\t\t\t\t\tif (campErr || !campaign) {\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\t\terror: `Referenced campaign not found: ${placement.scope_id}`\n\t\t\t\t\t\t};\n\t\t\t\t\t}\n\t\t\t\t\tif (campaign.tenant_id !== TENANT_ID) {\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\t\terror: `Cross-tenant assignment denied: campaign belongs to tenant ${campaign.tenant_id}, not current tenant ${TENANT_ID}`\n\t\t\t\t\t\t};\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\t// 4. Cross-tenant consistency check for sales_journey scope\n\t\t\tif (placement.scope_type === \"sales_journey\" && placement.scope_id) {\n\t\t\t\tif (isValidUuid(placement.scope_id)) {\n\t\t\t\t\tconst { data: journey, error: jErr } = await supabase.from(\"sales_journeys\").select(\"id, tenant_id\").eq(\"id\", placement.scope_id).single();\n\t\t\t\t\tif (jErr || !journey) {\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\t\terror: `Referenced sales journey not found: ${placement.scope_id}`\n\t\t\t\t\t\t};\n\t\t\t\t\t}\n\t\t\t\t\tif (journey.tenant_id !== TENANT_ID) {\n\t\t\t\t\t\treturn {\n\t\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\t\terror: `Cross-tenant assignment denied: sales journey belongs to tenant ${journey.tenant_id}, not current tenant ${TENANT_ID}`\n\t\t\t\t\t\t};\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tconst payload = {\n\t\t\t\ttenant_id: TENANT_ID,\n\t\t\t\tmedia_id: placement.media_id,\n\t\t\t\tplacement_key: placement.placement_key,\n\t\t\t\tscope_type: placement.scope_type,\n\t\t\t\tscope_id: placement.scope_id || null,\n\t\t\t\tsort_order: placement.sort_order ?? 0,\n\t\t\t\tactive: placement.active ?? true,\n\t\t\t\talt_text_override: placement.alt_text_override || null\n\t\t\t};\n\t\t\t// 5. Database write to media_placements\n\t\t\tconst { data: inserted, error: insertErr } = await supabase.from(\"media_placements\").insert(payload).select(\"id\").single();\n\t\t\tif (insertErr || !inserted) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: insertErr ? getErrMsg(insertErr, \"Database write failed: media placement was not persisted\") : \"Database write failed: no row returned from media_placements\"\n\t\t\t\t};\n\t\t\t}\n\t\t\t// 6. Acceptance verification: re-query persisted row from Supabase\n\t\t\tconst { data: verifiedRow, error: verifyErr } = await supabase.from(\"media_placements\").select(\"*, media_assets(*)\").eq(\"id\", inserted.id).eq(\"tenant_id\", TENANT_ID).single();\n\t\t\tif (verifyErr || !verifiedRow) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: `Publication verification failed: placement written with ID ${inserted.id} could not be re-queried from database (${verifyErr ? verifyErr.message : \"Record not found after write\"})`\n\t\t\t\t};\n\t\t\t}\n\t\t\tnotifySyncEvent(\"media_placements\", { id: verifiedRow.id }, \"INSERT\");\n\t\t\treturn {\n\t\t\t\tdata: verifiedRow,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\treturn {\n\t\t\t\tdata: null,\n\t\t\t\terror: getErrMsg(err, \"Failed to create placement\")\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t* Update an existing media placement with cross-tenant check and reload verification\n\t*/\n\tasync updatePlacement(id, updates) {\n\t\ttry {\n\t\t\tif (!isValidUuid(id)) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: `Invalid placement ID: must be a valid UUID (${id})`\n\t\t\t\t};\n\t\t\t}\n\t\t\t// Cross-tenant check for campaign updates\n\t\t\tif (updates.scope_type === \"campaign\" && updates.scope_id && isValidUuid(updates.scope_id)) {\n\t\t\t\tconst { data: campaign, error: campErr } = await supabase.from(\"campaigns\").select(\"id, tenant_id\").eq(\"id\", updates.scope_id).single();\n\t\t\t\tif (campErr || !campaign) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\terror: `Referenced campaign not found: ${updates.scope_id}`\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t\tif (campaign.tenant_id !== TENANT_ID) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\terror: `Cross-tenant assignment denied: campaign belongs to tenant ${campaign.tenant_id}, not current tenant ${TENANT_ID}`\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t\t// Cross-tenant check for sales_journey updates\n\t\t\tif (updates.scope_type === \"sales_journey\" && updates.scope_id && isValidUuid(updates.scope_id)) {\n\t\t\t\tconst { data: journey, error: jErr } = await supabase.from(\"sales_journeys\").select(\"id, tenant_id\").eq(\"id\", updates.scope_id).single();\n\t\t\t\tif (jErr || !journey) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\terror: `Referenced sales journey not found: ${updates.scope_id}`\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t\tif (journey.tenant_id !== TENANT_ID) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\terror: `Cross-tenant assignment denied: sales journey belongs to tenant ${journey.tenant_id}, not current tenant ${TENANT_ID}`\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t\tconst { data, error } = await supabase.from(\"media_placements\").update({\n\t\t\t\t...updates,\n\t\t\t\tupdated_at: new Date().toISOString()\n\t\t\t}).eq(\"id\", id).eq(\"tenant_id\", TENANT_ID).select(\"id\").single();\n\t\t\tif (error || !data) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: error ? getErrMsg(error, \"Update failed\") : \"Placement not found or update returned no data\"\n\t\t\t\t};\n\t\t\t}\n\t\t\t// Reload-based verification\n\t\t\tconst { data: verifiedRow, error: verifyErr } = await supabase.from(\"media_placements\").select(\"*, media_assets(*)\").eq(\"id\", id).eq(\"tenant_id\", TENANT_ID).single();\n\t\t\tif (verifyErr || !verifiedRow) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: `Publication verification failed: updated placement ${id} could not be verified on database reload`\n\t\t\t\t};\n\t\t\t}\n\t\t\tnotifySyncEvent(\"media_placements\", { id }, \"UPDATE\");\n\t\t\treturn {\n\t\t\t\tdata: verifiedRow,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\treturn {\n\t\t\t\tdata: null,\n\t\t\t\terror: getErrMsg(err, \"Failed to update placement\")\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t* Delete a media placement without deleting the underlying shared media asset\n\t*/\n\tasync deletePlacement(id) {\n\t\ttry {\n\t\t\tif (!isValidUuid(id)) {\n\t\t\t\treturn {\n\t\t\t\t\tsuccess: false,\n\t\t\t\t\terror: `Invalid placement ID: must be a valid UUID (${id})`\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst { error } = await supabase.from(\"media_placements\").delete().eq(\"id\", id).eq(\"tenant_id\", TENANT_ID);\n\t\t\tif (error) {\n\t\t\t\treturn {\n\t\t\t\t\tsuccess: false,\n\t\t\t\t\terror: getErrMsg(error, \"Database delete failed\")\n\t\t\t\t};\n\t\t\t}\n\t\t\tnotifySyncEvent(\"media_placements\", { id }, \"DELETE\");\n\t\t\treturn {\n\t\t\t\tsuccess: true,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\treturn {\n\t\t\t\tsuccess: false,\n\t\t\t\terror: getErrMsg(err, \"Failed to delete placement\")\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t* Reorder placements deterministically in database\n\t*/\n\tasync reorderPlacements(orderedIds) {\n\t\ttry {\n\t\t\tfor (let i = 0; i < orderedIds.length; i++) {\n\t\t\t\tconst id = orderedIds[i];\n\t\t\t\tif (!isValidUuid(id)) continue;\n\t\t\t\tconst { error } = await supabase.from(\"media_placements\").update({\n\t\t\t\t\tsort_order: i + 1,\n\t\t\t\t\tupdated_at: new Date().toISOString()\n\t\t\t\t}).eq(\"id\", id).eq(\"tenant_id\", TENANT_ID);\n\t\t\t\tif (error) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tsuccess: false,\n\t\t\t\t\t\terror: getErrMsg(error, `Failed to reorder placement ${id}`)\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t\tnotifySyncEvent(\"media_placements\", {}, \"UPDATE\");\n\t\t\treturn {\n\t\t\t\tsuccess: true,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\treturn {\n\t\t\t\tsuccess: false,\n\t\t\t\terror: getErrMsg(err, \"Failed to reorder placements\")\n\t\t\t};\n\t\t}\n\t}\n};\n\n//# sourceMappingURL=data:application/json;base64,"},"headersSize":292,"bodySize":36152,"redirectURL":"","_transferSize":36444},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":4.888,"receive":6.602},"_frameref":"frame@c6b3180024687624f679daa2979450f0","_monotonicTime":2777.972,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":3000,"_securityDetails":{}},{"pageref":"page@ade78e33f66f78cd029df07251dcf821","startedDateTime":"2026-10-16T19:53:35.063Z","time":12.096,"request":{"method":"GET","url":"http://localhost:3000/src/services/mediaService.ts","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:3000"},{"name":"Origin","value":"http://localhost:3000"},{"name":"Referer","value":"http://localhost:3000/src/pages/CommercialFunnelPage.tsx"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":586,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Access-Control-Allow-Origin","value":"http://localhost:3000"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"83109"},{"name":"Content-Type","value":"text/javascript"},{"name":"Date","value":"Fri, 16 Oct 2026 19:53:35 GMT"},{"name":"Etag","value":"W/\"5ed2-bC8jXrhgqV76zzPJ3eHzsk/zECc\""},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Vary","value":"Origin"}],"content":{"size":83109,"mimeType":"text/javascript","compression":0,"text":"import { supabase, TENANT_ID, notifySyncEvent } from \"/src/lib/supabase.ts\";\nexport const BUCKET_NAME = \"cp-public\";\nexport const MAX_FILE_SIZE_BYTES = 31457280;\nexport const CANONICAL_MIME_BY_EXT = {\n\tjpg: \"image/jpeg\",\n\tjpeg: \"image/jpeg\",\n\tpng: \"image/png\",\n\twebp: \"image/webp\",\n\tgif: \"image/gif\",\n\tmp4: \"video/mp4\",\n\twebm: \"video/webm\"\n};\nexport const EXT_BY_MIME = {\n\t\"image/jpeg\": \"jpg\",\n\t\"image/png\": \"png\",\n\t\"image/webp\": \"webp\",\n\t\"image/gif\": \"gif\",\n\t\"video/mp4\": \"mp4\",\n\t\"video/webm\": \"webm\"\n};\nexport const ALLOWED_MIMES = new Set([\n\t\"image/jpeg\",\n\t\"image/png\",\n\t\"image/webp\",\n\t\"image/gif\",\n\t\"video/mp4\",\n\t\"video/webm\"\n]);\nexport const ACCEPTED_IMAGE_MIME_TYPES = new Set([\n\t\"image/jpeg\",\n\t\"image/png\",\n\t\"image/webp\",\n\t\"image/gif\"\n]);\nconst UUID_REGEX = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nexport function isValidUuid(id) {\n\treturn typeof id === \"string\" && UUID_REGEX.test(id.trim());\n}\n/**\n\n* Pure validation and classification helper satisfying HOEOS Canonical Media Contract\n\n*/\nexport function validateAndClassifyMedia(file, _declaredCategory) {\n\tif (!file || typeof file !== \"object\") {\n\t\treturn {\n\t\t\tisValid: false,\n\t\t\terror: \"No file provided\"\n\t\t};\n\t}\n\tconst size = typeof file.size === \"number\" ? file.size : 0;\n\tif (size <= 0) {\n\t\treturn {\n\t\t\tisValid: false,\n\t\t\terror: \"File is empty (0 bytes)\"\n\t\t};\n\t}\n\tif (size > MAX_FILE_SIZE_BYTES) {\n\t\treturn {\n\t\t\tisValid: false,\n\t\t\terror: `File size exceeds bucket limit of 30 MB (${size} bytes)`\n\t\t};\n\t}\n\tconst rawFileName = file instanceof File || \"name\" in file && typeof file.name === \"string\" ? file.name.trim() : \"\";\n\tconst declaredMime = typeof file.type === \"string\" ? file.type.trim().toLowerCase() : \"\";\n\tlet finalMime = \"\";\n\tlet finalExt = \"\";\n\tif (rawFileName) {\n\t\tconst parts = rawFileName.split(\".\");\n\t\tconst ext = parts.length > 1 ? parts.pop().toLowerCase().trim() : \"\";\n\t\tif (!ext) {\n\t\t\tif (!declaredMime) {\n\t\t\t\treturn {\n\t\t\t\t\tisValid: false,\n\t\t\t\t\terror: \"File has no extension and no MIME type\"\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (!ALLOWED_MIMES.has(declaredMime)) {\n\t\t\t\treturn {\n\t\t\t\t\tisValid: false,\n\t\t\t\t\terror: `Unsupported MIME type: ${declaredMime}`\n\t\t\t\t};\n\t\t\t}\n\t\t\tfinalMime = declaredMime;\n\t\t\tfinalExt = EXT_BY_MIME[declaredMime];\n\t\t} else {\n\t\t\tconst canonicalMime = CANONICAL_MIME_BY_EXT[ext];\n\t\t\tif (!canonicalMime) {\n\t\t\t\treturn {\n\t\t\t\t\tisValid: false,\n\t\t\t\t\terror: `Unsupported file extension .${ext}. Allowed: .jpg, .jpeg, .png, .webp, .gif, .mp4, .webm`\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (declaredMime && declaredMime !== canonicalMime) {\n\t\t\t\t// Handle jpg/jpeg alias equivalence\n\t\t\t\tconst isJpegMatch = (ext === \"jpg\" || ext === \"jpeg\") && declaredMime === \"image/jpeg\";\n\t\t\t\tif (!isJpegMatch) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tisValid: false,\n\t\t\t\t\t\terror: `Contradictory file extension (.${ext}) and declared MIME type (${declaredMime})`\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t\tfinalMime = canonicalMime;\n\t\t\tfinalExt = ext;\n\t\t}\n\t} else {\n\t\t// Blob without filename\n\t\tif (!declaredMime) {\n\t\t\treturn {\n\t\t\t\tisValid: false,\n\t\t\t\terror: \"MIME type is required for Blob uploads without a filename\"\n\t\t\t};\n\t\t}\n\t\tif (!ALLOWED_MIMES.has(declaredMime)) {\n\t\t\treturn {\n\t\t\t\tisValid: false,\n\t\t\t\terror: `Unsupported MIME type: ${declaredMime}`\n\t\t\t};\n\t\t}\n\t\tfinalMime = declaredMime;\n\t\tfinalExt = EXT_BY_MIME[declaredMime];\n\t}\n\tconst cleanFileName = rawFileName ? rawFileName.replace(/[^a-zA-Z0-9._-]/g, \"_\") : `upload.${finalExt}`;\n\tlet mediaType = \"image\";\n\tlet editorCategory = \"image\";\n\tif (finalMime.startsWith(\"video/\")) {\n\t\tmediaType = \"video\";\n\t\teditorCategory = \"video\";\n\t} else if (finalMime === \"image/gif\") {\n\t\tmediaType = \"image\";\n\t\teditorCategory = \"animation\";\n\t} else {\n\t\tmediaType = \"image\";\n\t\teditorCategory = \"image\";\n\t}\n\treturn {\n\t\tisValid: true,\n\t\tmimeType: finalMime,\n\t\tmediaType,\n\t\teditorCategory,\n\t\textension: finalExt,\n\t\tcleanFileName,\n\t\tsizeBytes: size\n\t};\n}\nconst getErrMsg = (err, fallback) => {\n\tif (err && typeof err === \"object\" && \"message\" in err) {\n\t\treturn String(err.message);\n\t}\n\treturn err ? String(err) : fallback;\n};\n/**\n\n* Safely compensates for partial upload failure by deleting the created asset\n\n* and storage object only when no other product_media relations reference it.\n\n*/\nasync function safeCleanupUnreferencedAsset(assetId, storagePath) {\n\ttry {\n\t\t// Gate 1: reference status must be established before deleting anything.\n\t\tconst { data: refs, error: refErr } = await supabase.from(\"product_media\").select(\"product_id\").eq(\"media_id\", assetId);\n\t\tif (refErr || !Array.isArray(refs)) {\n\t\t\tconsole.error(\"[HOEOS RECOVERY] Reference status unknown; preserving asset and Storage object.\", refErr ?? \"Invalid reference query result\");\n\t\t\treturn false;\n\t\t}\n\t\tif (refs.length > 0) {\n\t\t\tconsole.warn(\"[HOEOS RECOVERY] Asset is referenced; preserving asset and Storage object.\", {\n\t\t\t\tassetId,\n\t\t\t\treferenceCount: refs.length\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\t// Gate 2: require confirmation that exactly this asset row was deleted.\n\t\tconst { data: deletedRows, error: deleteErr } = await supabase.from(\"media_assets\").delete().eq(\"id\", assetId).select(\"id\");\n\t\tif (deleteErr) {\n\t\t\tconsole.error(\"[HOEOS RECOVERY] Asset-row deletion failed; preserving Storage object.\", deleteErr);\n\t\t\treturn false;\n\t\t}\n\t\tif (!Array.isArray(deletedRows) || deletedRows.length !== 1 || deletedRows[0]?.id !== assetId) {\n\t\t\tconsole.error(\"[HOEOS RECOVERY] Asset-row deletion was not confirmed; preserving Storage object.\", {\n\t\t\t\tassetId,\n\t\t\t\tdeletedRows\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\t// Gate 3: only remove Storage after confirmed row deletion.\n\t\tconst { data: removedObjects, error: storageErr } = await supabase.storage.from(BUCKET_NAME).remove([storagePath]);\n\t\tif (storageErr || !Array.isArray(removedObjects) || removedObjects.length !== 1) {\n\t\t\tconsole.error(\"[HOEOS RECOVERY] Asset row deleted, but Storage removal was not confirmed.\", {\n\t\t\t\tassetId,\n\t\t\t\tstoragePath,\n\t\t\t\tstorageErr,\n\t\t\t\tremovedObjects\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\treturn true;\n\t} catch (cleanupErr) {\n\t\tconsole.error(\"[HOEOS RECOVERY] Cleanup state is uncertain; stopping further destructive actions.\", cleanupErr);\n\t\treturn false;\n\t}\n}\n/**\n* Pure file signature inspection helper detecting magic bytes where feasible.\n*/\nexport async function inspectFileSignature(file) {\n\ttry {\n\t\tif (!file || typeof file.slice !== \"function\") {\n\t\t\treturn { isValid: true };\n\t\t}\n\t\tconst slice = file.slice(0, 32);\n\t\tif (!slice || typeof slice.arrayBuffer !== \"function\") {\n\t\t\treturn { isValid: true };\n\t\t}\n\t\tconst buffer = await slice.arrayBuffer();\n\t\tconst bytes = new Uint8Array(buffer);\n\t\tif (bytes.length < 3) {\n\t\t\treturn { isValid: true };\n\t\t}\n\t\t// JPEG: FF D8 FF\n\t\tif (bytes[0] === 255 && bytes[1] === 216 && bytes[2] === 255) {\n\t\t\treturn {\n\t\t\t\tdetectedMime: \"image/jpeg\",\n\t\t\t\tisValid: true\n\t\t\t};\n\t\t}\n\t\t// PNG: 89 50 4E 47 0D 0A 1A 0A\n\t\tif (bytes.length >= 8 && bytes[0] === 137 && bytes[1] === 80 && bytes[2] === 78 && bytes[3] === 71 && bytes[4] === 13 && bytes[5] === 10 && bytes[6] === 26 && bytes[7] === 10) {\n\t\t\treturn {\n\t\t\t\tdetectedMime: \"image/png\",\n\t\t\t\tisValid: true\n\t\t\t};\n\t\t}\n\t\t// GIF: GIF87a (47 49 46 38 37 61) or GIF89a (47 49 46 38 39 61)\n\t\tif (bytes.length >= 6 && bytes[0] === 71 && bytes[1] === 73 && bytes[2] === 70 && bytes[3] === 56 && (bytes[4] === 55 || bytes[4] === 57) && bytes[5] === 97) {\n\t\t\treturn {\n\t\t\t\tdetectedMime: \"image/gif\",\n\t\t\t\tisValid: true\n\t\t\t};\n\t\t}\n\t\t// WebP: RIFF (bytes 0-3: 52 49 46 46) and WEBP (bytes 8-11: 57 45 42 50)\n\t\tif (bytes.length >= 12 && bytes[0] === 82 && bytes[1] === 73 && bytes[2] === 70 && bytes[3] === 70 && bytes[8] === 87 && bytes[9] === 69 && bytes[10] === 66 && bytes[11] === 80) {\n\t\t\treturn {\n\t\t\t\tdetectedMime: \"image/webp\",\n\t\t\t\tisValid: true\n\t\t\t};\n\t\t}\n\t\t// MP4: bytes 4-7: ftyp (66 74 79 70)\n\t\tif (bytes.length >= 8 && bytes[4] === 102 && bytes[5] === 116 && bytes[6] === 121 && bytes[7] === 112) {\n\t\t\treturn {\n\t\t\t\tdetectedMime: \"video/mp4\",\n\t\t\t\tisValid: true\n\t\t\t};\n\t\t}\n\t\t// WebM: 1A 45 DF A3\n\t\tif (bytes.length >= 4 && bytes[0] === 26 && bytes[1] === 69 && bytes[2] === 223 && bytes[3] === 163) {\n\t\t\treturn {\n\t\t\t\tdetectedMime: \"video/webm\",\n\t\t\t\tisValid: true\n\t\t\t};\n\t\t}\n\t\treturn { isValid: true };\n\t} catch {\n\t\treturn { isValid: true };\n\t}\n}\nexport const mediaService = {\n\t/**\n\t\n\t* Upload file to Supabase Storage (cp-public) and link via media_assets & product_media\n\t\n\t*/\n\tasync uploadMedia(productId, file, mediaType = \"image\", altText = \"\", isPrimary = false) {\n\t\ttry {\n\t\t\t// 0. Validate product ID syntax\n\t\t\tif (!isValidUuid(productId)) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: \"Invalid product ID: must be a valid UUID\"\n\t\t\t\t};\n\t\t\t}\n\t\t\t// 1. Validate and classify media file/blob\n\t\t\tconst validation = validateAndClassifyMedia(file, mediaType);\n\t\t\tif (!validation.isValid || !validation.mimeType || !validation.mediaType || !validation.cleanFileName) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: validation.error || \"Invalid media file\"\n\t\t\t\t};\n\t\t\t}\n\t\t\t// 2. Authoritative product existence and tenant authorization check\n\t\t\tconst { data: product, error: productErr } = await supabase.from(\"products\").select(\"id, tenant_id\").eq(\"id\", productId).single();\n\t\t\tif (productErr || !product) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: productErr ? getErrMsg(productErr, \"Product lookup failed or access denied\") : \"Product not found\"\n\t\t\t\t};\n\t\t\t}\n\t\t\tif (product.tenant_id !== TENANT_ID) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: `Product belongs to tenant ${product.tenant_id}, not current tenant ${TENANT_ID}`\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst cleanFileName = validation.cleanFileName;\n\t\t\tconst timestamp = Date.now();\n\t\t\tconst nonce = Math.random().toString(36).substring(2, 8);\n\t\t\tconst storagePath = `products/${productId}/${timestamp}_${nonce}_${cleanFileName}`;\n\t\t\tconst contentType = validation.mimeType;\n\t\t\t// 3. Upload to Supabase Storage bucket 'cp-public'\n\t\t\tconst { data: storageData, error: uploadErr } = await supabase.storage.from(BUCKET_NAME).upload(storagePath, file, {\n\t\t\t\tcontentType,\n\t\t\t\tupsert: true\n\t\t\t});\n\t\t\tif (uploadErr || !storageData) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: uploadErr ? getErrMsg(uploadErr, \"Storage upload failed\") : \"Storage upload failed\"\n\t\t\t\t};\n\t\t\t}\n\t\t\t// 4. Create record in media_assets\n\t\t\tconst assetRecord = {\n\t\t\t\ttenant_id: TENANT_ID,\n\t\t\t\tbucket: BUCKET_NAME,\n\t\t\t\tpath: storagePath,\n\t\t\t\tmedia_type: validation.mediaType,\n\t\t\t\tmime_type: contentType,\n\t\t\t\tfilename: cleanFileName,\n\t\t\t\tsize_bytes: validation.sizeBytes || file.size || 0,\n\t\t\t\talt_text: altText || cleanFileName,\n\t\t\t\tstatus: \"active\"\n\t\t\t};\n\t\t\tconst { data: assetCreated, error: assetErr } = await supabase.from(\"media_assets\").insert(assetRecord).select(\"*\").single();\n\t\t\tif (assetErr || !assetCreated) {\n\t\t\t\t// The insert response may be ambiguous. Preserve Storage because the\n\t\t\t\t// asset-row state cannot yet be proven and safely reconciled.\n\t\t\t\tconsole.error(\"[HOEOS RECOVERY] Asset insert was not confirmed; preserving Storage object for reconciliation.\", {\n\t\t\t\t\tstoragePath,\n\t\t\t\t\tassetErr: assetErr ?? null\n\t\t\t\t});\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: assetErr ? getErrMsg(assetErr, \"Failed to create media asset record; uploaded object preserved for reconciliation\") : \"Failed to create media asset; uploaded object preserved for reconciliation\"\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst mediaAsset = assetCreated;\n\t\t\t// 5. Query current max sort order for product\n\t\t\tconst { data: existingMedia, error: sortErr } = await supabase.from(\"product_media\").select(\"sort_order\").eq(\"product_id\", productId).order(\"sort_order\", { ascending: false });\n\t\t\tif (sortErr) {\n\t\t\t\tawait safeCleanupUnreferencedAsset(mediaAsset.id, storagePath);\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: getErrMsg(sortErr, \"Failed to query existing product media sort order\")\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst mediaArr = Array.isArray(existingMedia) ? existingMedia : [];\n\t\t\tconst nextOrder = mediaArr.length > 0 ? Number(mediaArr[0].sort_order || 0) + 1 : 1;\n\t\t\t// 6. If isPrimary, clear existing primary flags\n\t\t\tif (isPrimary) {\n\t\t\t\tconst { error: clearPrimaryErr } = await supabase.from(\"product_media\").update({ is_primary: false }).eq(\"product_id\", productId);\n\t\t\t\tif (clearPrimaryErr) {\n\t\t\t\t\tawait safeCleanupUnreferencedAsset(mediaAsset.id, storagePath);\n\t\t\t\t\treturn {\n\t\t\t\t\t\tdata: null,\n\t\t\t\t\t\terror: getErrMsg(clearPrimaryErr, \"Failed to update existing primary media\")\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t\t// 7. Link in product_media\n\t\t\tconst productMediaRecord = {\n\t\t\t\tproduct_id: productId,\n\t\t\t\tmedia_id: mediaAsset.id,\n\t\t\t\tsort_order: nextOrder,\n\t\t\t\tis_primary: isPrimary\n\t\t\t};\n\t\t\tconst { data: linkCreated, error: linkErr } = await supabase.from(\"product_media\").insert(productMediaRecord).select(\"*, media_assets(*)\").single();\n\t\t\tif (linkErr || !linkCreated) {\n\t\t\t\tawait safeCleanupUnreferencedAsset(mediaAsset.id, storagePath);\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: linkErr ? getErrMsg(linkErr, \"Failed to link product media\") : \"Failed to link media\"\n\t\t\t\t};\n\t\t\t}\n\t\t\t// 8. Deterministic sync notification after confirmed persistence\n\t\t\tnotifySyncEvent(\"product_media\", {\n\t\t\t\tproductId,\n\t\t\t\tmediaId: mediaAsset.id\n\t\t\t}, \"INSERT\");\n\t\t\treturn {\n\t\t\t\tdata: linkCreated,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\tconsole.error(\"Exception in uploadMedia:\", err);\n\t\t\treturn {\n\t\t\t\tdata: null,\n\t\t\t\terror: err instanceof Error ? err.message : \"Media upload error\"\n\t\t\t};\n\t\t}\n\t},\n\t/**\n\t\n\t* Reorder media assets for a product\n\t\n\t*/\n\tasync reorderMedia(productId, orderedMediaIds) {\n\t\ttry {\n\t\t\tif (!isValidUuid(productId)) {\n\t\t\t\treturn {\n\t\t\t\t\tsuccess: false,\n\t\t\t\t\terror: \"Invalid product ID: must be a valid UUID\"\n\t\t\t\t};\n\t\t\t}\n\t\t\tfor (let i = 0; i < orderedMediaIds.length; i++) {\n\t\t\t\tconst { error } = await supabase.from(\"product_media\").update({ sort_order: i + 1 }).eq(\"product_id\", productId).eq(\"media_id\", orderedMediaIds[i]);\n\t\t\t\tif (error) {\n\t\t\t\t\treturn {\n\t\t\t\t\t\tsuccess: false,\n\t\t\t\t\t\terror: getErrMsg(error, \"Reorder media error\")\n\t\t\t\t\t};\n\t\t\t\t}\n\t\t\t}\n\t\t\tnotifySyncEvent(\"product_media\", { productId }, \"UPDATE\");\n\t\t\treturn {\n\t\t\t\tsuccess: true,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (err) {\n\t\t\treturn {\n\t\t\t\tsuccess: false,\n\t\t\t\terror: err instanceof Error ? err.message : \"Reorder media error\"\n\