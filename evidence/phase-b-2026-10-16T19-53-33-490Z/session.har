upabase.from(\"campaigns\").select(\"*\").eq(\"tenant_id\", TENANT_ID).eq(\"slug\", slug).single();\n\t\tif (!cmp) return null;\n\t\treturn cmp;\n\t},\n\tasync createCampaign(campaign) {\n\t\ttry {\n\t\t\tconst slug = (campaign.slug || campaign.name || \"campaign\").toLowerCase().replace(/[^a-z0-9]+/g, \"-\").replace(/(^-|-$)/g, \"\");\n\t\t\tconst record = {\n\t\t\t\ttenant_id: TENANT_ID,\n\t\t\t\tname: campaign.name || \"New Campaign\",\n\t\t\t\tslug,\n\t\t\t\tdescription: campaign.description || null,\n\t\t\t\tstatus: campaign.status || \"draft\",\n\t\t\t\tstarts_at: campaign.starts_at || null,\n\t\t\t\tends_at: campaign.ends_at || null,\n\t\t\t\tlanding_path: campaign.landing_path || `/campaign/${slug}`,\n\t\t\t\tdefault_utm_source: campaign.default_utm_source || \"social\",\n\t\t\t\tdefault_utm_medium: campaign.default_utm_medium || \"influencer\",\n\t\t\t\tdefault_utm_campaign: campaign.default_utm_campaign || slug\n\t\t\t};\n\t\t\tconst { data, error } = await supabase.from(\"campaigns\").insert(record).select().single();\n\t\t\tif (error || !data) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: error ? getErrMsg(error, \"Failed to create campaign\") : \"Failed to create campaign\"\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tdata,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (e) {\n\t\t\treturn {\n\t\t\t\tdata: null,\n\t\t\t\terror: e instanceof Error ? e.message : \"Error creating campaign\"\n\t\t\t};\n\t\t}\n\t},\n\t// Influencers API\n\tasync getInfluencers() {\n\t\tconst { data } = await supabase.from(\"influencers\").select(\"*\").eq(\"tenant_id\", TENANT_ID).order(\"created_at\", { ascending: false });\n\t\treturn data || [];\n\t},\n\tasync createInfluencer(influencer) {\n\t\ttry {\n\t\t\tconst record = {\n\t\t\t\ttenant_id: TENANT_ID,\n\t\t\t\tname: influencer.name || \"\",\n\t\t\t\thandle: influencer.handle || null,\n\t\t\t\tplatform: influencer.platform || \"instagram\",\n\t\t\t\tprofile_url: influencer.profile_url || null,\n\t\t\t\tphone: influencer.phone || null,\n\t\t\t\temail: influencer.email || null,\n\t\t\t\tstatus: influencer.status || \"active\"\n\t\t\t};\n\t\t\tconst { data, error } = await supabase.from(\"influencers\").insert(record).select().single();\n\t\t\tif (error || !data) {\n\t\t\t\treturn {\n\t\t\t\t\tdata: null,\n\t\t\t\t\terror: error ? getErrMsg(error, \"Failed to create influencer\") : \"Failed to create influencer\"\n\t\t\t\t};\n\t\t\t}\n\t\t\treturn {\n\t\t\t\tdata,\n\t\t\t\terror: null\n\t\t\t};\n\t\t} catch (e) {\n\t\t\treturn {\n\t\t\t\tdata: null,\n\t\t\t\terror: e instanceof Error ? e.message : \"Error creating influencer\"\n\t\t\t};\n\t\t}\n\t}\n};\n\n//# sourceMappingURL=data:application/json;base64,"},"headersSize":291,"bodySize":11359,"redirectURL":"","_transferSize":11650},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":5.6,"receive":6.014},"_frameref":"frame@c6b3180024687624f679daa2979450f0","_monotonicTime":2771.249,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":3000,"_securityDetails":{}},{"pageref":"page@ade78e33f66f78cd029df07251dcf821","startedDateTime":"2026-10-16T19:53:35.051Z","time":7.692,"request":{"method":"GET","url":"http://localhost:3000/src/services/productHelpers.ts","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:3000"},{"name":"Origin","value":"http://localhost:3000"},{"name":"Referer","value":"http://localhost:3000/src/pages/CampaignLandingPage.tsx"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":587,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Access-Control-Allow-Origin","value":"http://localhost:3000"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"18495"},{"name":"Content-Type","value":"text/javascript"},{"name":"Date","value":"Fri, 16 Oct 2026 19:53:35 GMT"},{"name":"Etag","value":"W/\"1664-Nv5NV1XhANei39XVBPN84M8/NK4\""},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Vary","value":"Origin"}],"content":{"size":18495,"mimeType":"text/javascript","compression":0,"text":"const DEFAULT_CURRENCY = \"NGN\";\n// Deterministic neutral bottle silhouette placeholder (Zero external Unsplash dependencies)\nexport const BRAND_PLACEHOLDER_IMAGE = \"data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400' fill='none'%3E%3Crect width='400' height='400' fill='%231c1917'/%3E%3Cpath d='M175 60h50v30h-50zM160 90h80c10 0 20 15 20 30v190c0 20-15 30-30 30h-60c-15 0-30-10-30-30V120c0-15 10-30 20-30z' fill='%2344403c'/%3E%3Ccircle cx='200' cy='200' r='36' fill='%23e11d48' opacity='0.8'/%3E%3Ctext x='200' y='206' fill='white' font-family='sans-serif' font-size='16' font-weight='bold' text-anchor='middle'%3ECP%3C/text%3E%3Ctext x='200' y='360' fill='%23a8a29e' font-family='sans-serif' font-size='12' text-anchor='middle'%3ECP Fruit Splash%3C/text%3E%3C/svg%3E\";\n/**\n* Resolves the active pricing for a product from its variants and price records.\n*/\nexport function getProductPrice(product) {\n\tif (!product || !product.variants || product.variants.length === 0) {\n\t\treturn {\n\t\t\tamount: 0,\n\t\t\tcompare_at_amount: null,\n\t\t\tcurrency: DEFAULT_CURRENCY\n\t\t};\n\t}\n\t// Find active variant\n\tconst variant = product.variants.find((v) => v.status === \"active\") || product.variants[0];\n\tif (!variant || !variant.prices || variant.prices.length === 0) {\n\t\treturn {\n\t\t\tamount: 0,\n\t\t\tcompare_at_amount: null,\n\t\t\tcurrency: DEFAULT_CURRENCY\n\t\t};\n\t}\n\t// Find active price\n\tconst price = variant.prices.find((p) => p.status === \"active\") || variant.prices[0];\n\tif (!price) {\n\t\treturn {\n\t\t\tamount: 0,\n\t\t\tcompare_at_amount: null,\n\t\t\tcurrency: DEFAULT_CURRENCY\n\t\t};\n\t}\n\treturn {\n\t\tamount: Number(price.amount) || 0,\n\t\tcompare_at_amount: price.compare_at_amount ? Number(price.compare_at_amount) : null,\n\t\tcompareAtAmount: price.compare_at_amount ? Number(price.compare_at_amount) : null,\n\t\tcurrency: DEFAULT_CURRENCY\n\t};\n}\n/**\n* Resolves physical volume specifications for a product from its variants.\n*/\nexport function getProductVolume(product) {\n\tif (!product || !product.variants || product.variants.length === 0) {\n\t\treturn {\n\t\t\tvolume: 500,\n\t\t\tunit: \"ml\"\n\t\t};\n\t}\n\tconst variant = product.variants.find((v) => v.status === \"active\") || product.variants[0];\n\treturn {\n\t\tvolume: variant.volume ? Number(variant.volume) : 500,\n\t\tunit: variant.volume_unit || \"ml\"\n\t};\n}\n/**\n* Resolves the primary/hero media public URL for a product from media_assets.\n*/\nexport function getProductHeroMediaUrl(product) {\n\tif (!product || !product.media || product.media.length === 0) {\n\t\treturn BRAND_PLACEHOLDER_IMAGE;\n\t}\n\t// Primary media first, then sort_order\n\tconst primaryRel = product.media.find((m) => m.is_primary) || product.media[0];\n\tconst asset = primaryRel.media_assets || primaryRel.asset;\n\tif (!asset) {\n\t\treturn BRAND_PLACEHOLDER_IMAGE;\n\t}\n\tif (asset.public_url) {\n\t\treturn asset.public_url;\n\t}\n\tif (asset.bucket && asset.path) {\n\t\treturn `https://efvvczmopacoroudzfnl.supabase.co/storage/v1/object/public/${asset.bucket}/${asset.path}`;\n\t}\n\treturn BRAND_PLACEHOLDER_IMAGE;\n}\n/**\n* Resolves claims for a product.\n*/\nexport function getProductClaims(product, verifiedOnly = false) {\n\tif (!product || !product.claims) {\n\t\treturn [];\n\t}\n\tif (verifiedOnly) {\n\t\treturn product.claims.filter((c) => c.verification_status === \"verified\");\n\t}\n\treturn product.claims;\n}\nexport const DEFAULT_ANIMATION_CONFIG = {\n\tenabled: true,\n\tduration_seconds: 4.5,\n\tloop: true,\n\tautoplay: true,\n\taspect_ratio: \"square\"\n};\nexport const SEQUENCE_ROLES_META = [\n\t{\n\t\trole: \"hero_bottle\",\n\t\tposition: 1,\n\t\tlabel: \"01 Clean Hero Bottle\",\n\t\tdescription: \"Primary product recognition with controlled push zoom\"\n\t},\n\t{\n\t\trole: \"premium_three_quarter\",\n\t\tposition: 2,\n\t\tlabel: \"02 Premium 3/4 Bottle\",\n\t\tdescription: \"Depth presentation with camera orbit & lighting\"\n\t},\n\t{\n\t\trole: \"ingredient_explosion\",\n\t\tposition: 3,\n\t\tlabel: \"03 Ingredient Explosion\",\n\t\tdescription: \"Whole botanicals and fruits revealing formulation\"\n\t},\n\t{\n\t\trole: \"lifestyle\",\n\t\tposition: 4,\n\t\tlabel: \"04 Lifestyle Model\",\n\t\tdescription: \"Natural human context and wellness interaction\"\n\t},\n\t{\n\t\trole: \"serving\",\n\t\tposition: 5,\n\t\tlabel: \"05 Serving Shot\",\n\t\tdescription: \"Chilled glass pouring, ice motion, cold condensation\"\n\t},\n\t{\n\t\trole: \"campaign_hero\",\n\t\tposition: 6,\n\t\tlabel: \"06 Surreal Campaign Hero\",\n\t\tdescription: \"Selective cinematic artistic treatment\"\n\t}\n];\nexport function getProductAnimationConfig(product) {\n\tconst meta = product?.metadata || {};\n\tconst raw = meta.animation_config;\n\treturn {\n\t\tenabled: raw?.enabled !== undefined ? Boolean(raw.enabled) : true,\n\t\tduration_seconds: typeof raw?.duration_seconds === \"number\" ? raw.duration_seconds : 4.5,\n\t\tloop: raw?.loop !== undefined ? Boolean(raw.loop) : true,\n\t\tautoplay: raw?.autoplay !== undefined ? Boolean(raw.autoplay) : true,\n\t\taspect_ratio: raw?.aspect_ratio || \"square\"\n\t};\n}\nexport function getProductMediaSequence(product) {\n\tconst meta = product?.metadata || {};\n\tconst rawSequence = meta.media_sequence;\n\tif (Array.isArray(rawSequence) && rawSequence.length > 0) {\n\t\treturn rawSequence;\n\t}\n\t// Derive sequence from product.media if not explicitly configured\n\tconst mediaList = product?.media || [];\n\treturn SEQUENCE_ROLES_META.map((metaItem, idx) => {\n\t\tconst matchedMedia = mediaList[idx];\n\t\treturn {\n\t\t\tposition: metaItem.position,\n\t\t\trole: metaItem.role,\n\t\t\tmedia_id: matchedMedia ? matchedMedia.media_id : \"\",\n\t\t\tcustom_label: metaItem.label,\n\t\t\tenabled: Boolean(matchedMedia)\n\t\t};\n\t});\n}\n/**\n* Gets the primary variant of a product.\n*/\nexport function getProductPrimaryVariant(product) {\n\tif (!product || !product.variants || product.variants.length === 0) {\n\t\treturn undefined;\n\t}\n\treturn product.variants.find((v) => v.status === \"active\") || product.variants[0];\n}\n\n//# sourceMappingURL=data:application/json;base64,"},"headersSize":292,"bodySize":18495,"redirectURL":"","_transferSize":18787},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":2.084,"receive":5.608},"_frameref":"frame@c6b3180024687624f679daa2979450f0","_monotonicTime":2771.51,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":3000,"_securityDetails":{}},{"pageref":"page@ade78e33f66f78cd029df07251dcf821","startedDateTime":"2026-10-16T19:53:35.051Z","time":9.456,"request":{"method":"GET","url":"http://localhost:3000/src/services/claimsService.ts","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:3000"},{"name":"Origin","value":"http://localhost:3000"},{"name":"Referer","value":"http://localhost:3000/src/pages/ClaimsPage.tsx"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetc