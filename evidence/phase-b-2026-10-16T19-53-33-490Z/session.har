cord into Supabase orders & order_items tables\n\t\tordersService.createOrder({\n\t\t\tcustomer_name: customerName.trim() || \"Valued Customer\",\n\t\t\tcustomer_phone: customerPhone.trim() || BUSINESS_CONFIG.contact.enquiryPhoneDisplay,\n\t\t\tcustomer_location: deliveryLocation,\n\t\t\tdelivery_address: deliveryAddress.trim() || null,\n\t\t\tchannel: \"whatsapp\",\n\t\t\tstatus: \"pending\",\n\t\t\tcurrency: \"NGN\",\n\t\t\ttotal_amount: subtotal,\n\t\t\tnotes: note.trim() || null,\n\t\t\titems: [{\n\t\t\t\tproduct_id: product.id,\n\t\t\t\tvariant_id: primaryVariant?.id || null,\n\t\t\t\tproduct_name: product.name,\n\t\t\t\tquantity,\n\t\t\t\tunit_price: unitPrice,\n\t\t\t\tvolume: volumeInfo.volume,\n\t\t\t\tsubtotal\n\t\t\t}]\n\t\t});\n\t\t// 3. Track analytics event deterministically into Supabase\n\t\tanalyticsService.trackEvent(\"order_started\", {\n\t\t\tproductId: product.id,\n\t\t\tlandingPage: window.location.pathname,\n\t\t\tmetadata: {\n\t\t\t\tproduct_name: product.name,\n\t\t\t\tquantity,\n\t\t\t\tsubtotal,\n\t\t\t\tlocation: deliveryLocation\n\t\t\t}\n\t\t});\n\t\tanalyticsService.trackEvent(\"whatsapp_click\", {\n\t\t\tproductId: product.id,\n\t\t\tmetadata: {\n\t\t\t\ttarget: \"whatsapp_order_flow\",\n\t\t\t\tphone: phoneNumber\n\t\t\t}\n\t\t});\n\t\tsetOrderSent(true);\n\t\t// Open WhatsApp link in new tab\n\t\twindow.open(whatsappUrl, \"_blank\", \"noopener,noreferrer\");\n\t};\n\treturn /* @__PURE__ */ _jsxDEV(\"div\", {\n\t\tclassName: \"fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto animate-in fade-in duration-200\",\n\t\tchildren: /* @__PURE__ */ _jsxDEV(\"div\", {\n\t\t\tclassName: \"bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-stone-200 relative my-8\",\n\t\t\tchildren: [/* @__PURE__ */ _jsxDEV(\"button\", {\n\t\t\t\tonClick: onClose,\n\t\t\t\tclassName: \"absolute top-5 right-5 p-2 rounded-full text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition