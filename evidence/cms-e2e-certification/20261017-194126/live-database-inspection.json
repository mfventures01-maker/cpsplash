  "tenant_helpers": [
    {
      "definition": "CREATE OR REPLACE FUNCTION public.has_tenant_role(_tenant_id uuid, _role_names text[])\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  SELECT EXISTS (\n    SELECT 1\n    FROM public.tenant_memberships tm\n    JOIN public.roles r ON r.id = tm.role_id\n    WHERE tm.tenant_id = _tenant_id\n      AND tm.user_id = auth.uid()\n      AND tm.status = 'active'\n      AND r.name = ANY(_role_names)\n  );\n$function$\n",
      "proacl": "postgres=X/postgres; service_role=X/postgres; authenticated=X/postgres",
      "proname": "has_tenant_role",
      "prosecdef": true
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION public.is_tenant_member(_tenant_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  SELECT EXISTS (\n    SELECT 1\n    FROM public.tenant_memberships tm\n    WHERE tm.tenant_id = _tenant_id\n      AND tm.user_id = auth.uid()\n      AND tm.status = 'active'\n  );\n$function$\n",
      "proacl": "postgres=X/postgres; service_role=X/postgres; authenticated=X/postgres",
      "proname": "is_tenant_member",
      "prosecdef": true
    },
    {
      "definition": "CREATE OR REPLACE FUNCTION public.update_media_placements_modtime()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    NEW.updated_at = NOW();\n    RETURN NEW;\nEND;\n$function$\n",
      "proacl": "=X/postgres; postgres=X/postgres; anon=X/postgres; authenticated=X/postgres; service_role=X/postgres",
      "proname": "update_media_placements_modtime",
      "prosecdef": false
    }
  ],
